{
  "rewrites": [
    {
      "source": "/etherscan/:path*",
      "destination": "https://api.etherscan.io/:path*"
    },
    {
      "source": "/goplus/:path*",
      "destination": "https://api.gopluslabs.io/:path*"
    },
    {
      "source": "/aura-api/:path*",
      "destination": "https://api.neo4j.io/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}